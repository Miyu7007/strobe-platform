# ===== Demo 模式 =====
# 设置为 true 可在没有 Supabase 账号的情况下本地试用
# 数据存在内存中，重启服务后会清空，仅供测试
NEXT_PUBLIC_DEMO_MODE=true

# ===== Supabase 凭据（Demo 模式可留空，正式上线时必填） =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 积分规则 =====
REGISTER_BONUS_POINTS=100
SHARE_REWARD_POINTS=10
DOWNLOAD_COST_POINTS=5